{
  "name": "codem",
  "private": true,
  "version": "1.16.174",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:snapshot": "vitest run --config vitest.snapshot.config.ts",
    "audit:false-success": "node tools/audit/scan-false-success.mjs",
    "audit:fail-open": "node tools/audit/scan-fail-open-guards.mjs --check",
    "audit:report-sites": "node tools/audit/scan-report-sites.mjs --check",
    "audit:silent-write": "node tools/audit/scan-silent-write.mjs",
    "audit": "npm run audit:silent-write && npm run audit:false-success && npm run audit:guard-bypass && npm run audit:fail-open && npm run audit:report-sites && npm run audit:storage-boundary && npm run audit:unrouted-db && npm run audit:schema-parity && npm run audit:coverage && npm run audit:command-parity && npm run audit:row-builders && npm run audit:write-return && npm run audit:token-hygiene && npm run audit:style-literals && npm run audit:color-roles && npm run audit:regex-unicode && npm run audit:reachability && npm run audit:probe-guard && npm run audit:node-syntax && npm run audit:gaplist",
    "audit:token-hygiene": "node tools/audit/scan-token-hygiene.mjs --check",
    "audit:style-literals": "node tools/audit/scan-style-literals.mjs --check",
    "audit:unrouted-db": "node tools/audit/scan-unrouted-db.mjs --check",
    "audit:guard-bypass": "node tools/audit/scan-guard-bypass.mjs",
    "audit:storage-boundary": "node tools/audit/scan-storage-boundary.mjs",
    "audit:schema-parity": "node tools/audit/gen-schema-sql.mjs --check",
    "audit:command-parity": "node tools/audit/check-command-parity.mjs",
    "audit:row-builders": "node tools/audit/check-row-builders.mjs",
    "audit:write-return": "node tools/audit/check-write-return.mjs",
    "audit:regex-unicode": "node tools/audit/scan-regex-unicode.mjs --strict",
    "audit:reachability": "node tools/audit/reachability-scan.mjs --check",
    "verify:update-manifest": "node tools/release/verify-update-manifest.mjs",
    "audit:coverage": "node tools/audit/storage-coverage.mjs --check",
    "audit:coverage-baseline": "node tools/audit/coverage-baseline.mjs --check",
    "audit:coverage-per-file": "node tools/audit/coverage-per-file.mjs --check",
    "audit:coverage-files": "node tools/audit/coverage-per-file.mjs",
    "audit:knip": "node tools/audit/knip-gate.mjs",
    "audit:inventory": "node tools/audit/storage-inventory.mjs",
    "audit:inventory-md": "node tools/audit/storage-inventory.mjs --md",
    "audit:json": "node tools/audit/scan-silent-write.mjs --json && node tools/audit/scan-false-success.mjs --json && node tools/audit/scan-guard-bypass.mjs --json && node tools/audit/scan-storage-boundary.mjs --json",
    "db:build": "cargo build --manifest-path src-tauri/codem-db/Cargo.toml",
    "db:test": "cargo test --manifest-path src-tauri/codem-db/Cargo.toml",
    "db:cli": "cargo run --manifest-path src-tauri/codem-db/Cargo.toml --bin codem-db-cli --",
    "test:db": "npm run db:build && vitest run src/test/db-contract.test.ts",
    "bench:db": "npm run db:build && node tools/bench/db-scale.mjs",
    "bench:mem": "npm run db:build && node tools/bench/memory-bound.mjs",
    "migrate:plan": "npm run db:build && node tools/migrate/storage-migrate.mjs --dry-run",
    "migrate:apply": "npm run db:build && node tools/migrate/storage-migrate.mjs --apply",
    "migrate:verify": "npm run db:build && node tools/migrate/storage-migrate.mjs --verify",
    "migrate:rollback-hint": "node tools/migrate/storage-migrate.mjs --rollback-hint",
    "migrate:bite": "npm run db:build && node tools/migrate/bite-reconcile.mjs",
    "verify": "vitest run --coverage && node tools/audit/coverage-baseline.mjs --check && node tools/audit/coverage-per-file.mjs --check && node tools/audit/knip-gate.mjs && npx jscpd",
    "audit:probe-guard": "node tools/audit/probe-guard.selftest.mjs",
    "audit:node-syntax": "node tools/audit/check-node-syntax.mjs",
    "audit:gaplist": "node tools/audit/check-gaplist.mjs",
    "audit:color-roles": "node tools/audit/scan-color-roles.mjs --check"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.5",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "framer-motion": "^13.0.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "pdfjs-dist": "^6.1.200",
    "phaser": "^3.90.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.2",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.10.6",
    "jscpd": "^5.3.2",
    "jsdom": "^29.1.1",
    "knip": "^6.38.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
